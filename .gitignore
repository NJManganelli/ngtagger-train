mlruns/
output/
firmware/
__pycache__/
*.egg-info/
.pytest_cache/

# transient run outputs (never source, never committed study artifacts)
.DS_Store
mlflow.db
# large intermediate feature dumps land at the repo root
/*.parquet
# generated xgboost model checkpoints from a train_matrix run (the committed
# study artifacts under eval_refitq/vtxdxy/ and eval_refitq/modelspace/ are NOT
# ignored -- only this generated checkpoint dir is)
eval_refitq/models/
# model checkpoints / frozen graphs
*.keras
*.pb

# large regenerable presentation artifact (make_refit_viz.py rebuilds it)
eval_refitq/refitviz/*.html

# MVA explorer rendered site + exported data (regenerable: python -m ngtagger.viz.mva_explorer export-all)
eval_mva_explorer/
# Stage-4 per-jet prediction dumps (regenerable via the stage4 matrix re-run)
eval_refitq/stage4/pred_dumps/
